* text=auto

# Ensure bash scripts stay executable on Linux
*.sh text eol=lf
*.sql text eol=lf
*.xml text eol=lf

# Tauri CLI rewrites this manifest with LF; keep Windows checkouts byte-stable.
apps/desktop/src-tauri/Cargo.toml text eol=lf
# Gradle wrapper の起動 script は OS ごとの改行で取り出す。
apps/desktop/src-tauri/gen/android/gradlew text eol=lf
apps/desktop/src-tauri/gen/android/gradlew.bat text eol=crlf
