# Generated by Terraform (infra/terraform/modules/gcp-vm-compose). Do not edit on the VM.
# Non-secret container env, shared by cn-user-api and cn-iroh-relay via env_file.
# Secrets are injected separately through the project .env at boot.

# --- cn-user-api ---
COMMUNITY_NODE_BIND_ADDR=0.0.0.0:${api_port}
COMMUNITY_NODE_DATABASE_INIT_MODE=require_ready
COMMUNITY_NODE_RENDEZVOUS_KEY_PREFIX=${rendezvous_key_prefix}
COMMUNITY_NODE_BASE_URL=https://${api_domain}
COMMUNITY_NODE_PUBLIC_BASE_URL=https://${api_domain}
COMMUNITY_NODE_CONNECTIVITY_URLS=https://${relay_domain}
COMMUNITY_NODE_JWT_ISSUER=${jwt_issuer}
COMMUNITY_NODE_JWT_TTL_SECONDS=${jwt_ttl_seconds}
COMMUNITY_NODE_RATE_LIMIT_ENABLED=${rate_limit_enabled}
COMMUNITY_NODE_RATE_LIMIT_PER_SECOND=${rate_limit_per_second}
COMMUNITY_NODE_RATE_LIMIT_BURST=${rate_limit_burst}
# Caddy は信頼できる reverse proxy なので、クライアント単位 rate limit のため
# X-Forwarded-For を信頼させる。
COMMUNITY_NODE_RATE_LIMIT_TRUST_FORWARDED_FOR=true
COMMUNITY_NODE_DEPLOYMENT_REVISION=${deployment_revision}
COMMUNITY_NODE_READINESS_ACTIVATION_MAX_AGE_SECS=900

# --- cn-iroh-relay ---
COMMUNITY_NODE_IROH_RELAY_HTTP_BIND_ADDR=0.0.0.0:${relay_http_port}
COMMUNITY_NODE_IROH_RELAY_QUIC_BIND_ADDR=0.0.0.0:${relay_quic_internal_port}
COMMUNITY_NODE_IROH_RELAY_TLS_CERT_PATH=${certs_mount}/live/${cert_name}/fullchain.pem
COMMUNITY_NODE_IROH_RELAY_TLS_KEY_PATH=${certs_mount}/live/${cert_name}/privkey.pem
%{ if iroh_relay_client_rx_bytes_per_second > 0 ~}
COMMUNITY_NODE_IROH_RELAY_CLIENT_RX_BYTES_PER_SECOND=${iroh_relay_client_rx_bytes_per_second}
%{ endif ~}
%{ if iroh_relay_client_rx_max_burst_bytes > 0 ~}
COMMUNITY_NODE_IROH_RELAY_CLIENT_RX_MAX_BURST_BYTES=${iroh_relay_client_rx_max_burst_bytes}
%{ endif ~}

# --- blob cache (informational; disabled by default) ---
# blob/media 本体は Postgres に保存しない。enabled 時も rebuildable cache として扱い、
# backup 対象外の専用 path に置く。
KUKURI_BLOB_CACHE_ENABLED=${blob_cache_enabled}
KUKURI_BLOB_CACHE_TTL_HOURS=${blob_cache_ttl_hours}
KUKURI_BLOB_CACHE_PATH=${blob_cache_path}
%{ if deploy_indexer_stack ~}

# --- index / moderation stack (#615) ---
# secrets（channel key / signing key / Arachnid credentials / ArcadeDB password / VLM key）は
# この file には置かず、boot 時に Secret Manager から project .env へ注入される。
# ユーザー向け read surface は full-stack E2E 完了まで既定 false を維持する（無効時は 404）。
COMMUNITY_NODE_INDEX_QUERY_ENABLED=${index_query_enabled}
COMMUNITY_NODE_TRUST_READ_ENABLED=${trust_read_enabled}
COMMUNITY_NODE_RELATION_DISTANCE_OPTOUT_MIN_PROXIMITY=${relation_distance_optout_min_proximity}
%{ if trust_w_abs_negative != "" ~}
COMMUNITY_NODE_TRUST_W_ABS_NEGATIVE=${trust_w_abs_negative}
%{ endif ~}
%{ if trust_w_abs_positive != "" ~}
COMMUNITY_NODE_TRUST_W_ABS_POSITIVE=${trust_w_abs_positive}
%{ endif ~}
%{ if trust_relative_half_life_days != "" ~}
COMMUNITY_NODE_TRUST_RELATIVE_HALF_LIFE_DAYS=${trust_relative_half_life_days}
%{ endif ~}

# ArcadeDB 接続（cn-user-api の read / cn-indexer の投影で共有。password は .env 側）。
COMMUNITY_NODE_ARCADEDB_URL=http://cn-arcadedb:2480
COMMUNITY_NODE_ARCADEDB_DATABASE=kukuri_index
COMMUNITY_NODE_ARCADEDB_USER=root

# --- cn-indexer ---
COMMUNITY_NODE_INDEXER_DATA_DIR=${indexer_data_path}
COMMUNITY_NODE_INDEXER_OWN_RELAY=${indexer_own_relay}
%{ if indexer_external_relay_urls != "" ~}
COMMUNITY_NODE_INDEXER_EXTERNAL_RELAY_URLS=${indexer_external_relay_urls}
%{ endif ~}
COMMUNITY_NODE_INDEXER_STATUS_ADDR=0.0.0.0:${indexer_status_port}
COMMUNITY_NODE_INDEXER_RETENTION_DAYS=${indexer_retention_days}
COMMUNITY_NODE_INDEXER_CAPACITY_ROWS=${indexer_capacity_rows}
%{ if safety_provider_known_csam != "" ~}
COMMUNITY_NODE_SAFETY_PROVIDER_KNOWN_CSAM=${safety_provider_known_csam}
COMMUNITY_NODE_SAFETY_PROVIDER_KNOWN_CSAM_REQUIRED=${safety_provider_known_csam_required}
%{ endif ~}
%{ if safety_provider_general != "" ~}
COMMUNITY_NODE_SAFETY_PROVIDER_GENERAL=${safety_provider_general}
COMMUNITY_NODE_SAFETY_PROVIDER_GENERAL_REQUIRED=${safety_provider_general_required}
%{ endif ~}
%{ if safety_provider_unknown_csam != "" ~}
COMMUNITY_NODE_SAFETY_PROVIDER_UNKNOWN_CSAM=${safety_provider_unknown_csam}
COMMUNITY_NODE_SAFETY_PROVIDER_UNKNOWN_CSAM_REQUIRED=${safety_provider_unknown_csam_required}
%{ endif ~}
COMMUNITY_NODE_SAFETY_EMIT_SIGNED_EVENTS=${safety_emit_signed_events}
%{ if safety_suspected_threshold > 0 ~}
COMMUNITY_NODE_SAFETY_SUSPECTED_THRESHOLD=${safety_suspected_threshold}
%{ endif ~}
%{ if safety_suspected_signal_visibility != "" ~}
COMMUNITY_NODE_SAFETY_SUSPECTED_SIGNAL_VISIBILITY=${safety_suspected_signal_visibility}
%{ endif ~}
%{ if safety_general_action != "" ~}
COMMUNITY_NODE_SAFETY_GENERAL_ACTION=${safety_general_action}
%{ endif ~}
%{ if safety_operator_review ~}
COMMUNITY_NODE_SAFETY_OPERATOR_REVIEW=true
%{ endif ~}
%{ if media_fetch_max_bytes > 0 ~}
COMMUNITY_NODE_MEDIA_FETCH_MAX_BYTES=${media_fetch_max_bytes}
%{ endif ~}
%{ if media_fetch_timeout_secs > 0 ~}
COMMUNITY_NODE_MEDIA_FETCH_TIMEOUT_SECS=${media_fetch_timeout_secs}
%{ endif ~}

# --- VLM endpoint (#420) ---
# self-host endpoint は WireGuard 等の private 経路で到達させ、public internet へ公開しない。
# VLM 不達時は indexer 側で fail-closed（allow に落ちない）。
%{ if vlm_api_base_url != "" ~}
COMMUNITY_NODE_VLM_API_BASE_URL=${vlm_api_base_url}
%{ endif ~}
%{ if vlm_model != "" ~}
COMMUNITY_NODE_VLM_MODEL=${vlm_model}
%{ endif ~}
%{ if vlm_response_format != "" ~}
COMMUNITY_NODE_VLM_RESPONSE_FORMAT=${vlm_response_format}
%{ endif ~}
%{ if vlm_api_timeout_secs > 0 ~}
COMMUNITY_NODE_VLM_API_TIMEOUT_SECS=${vlm_api_timeout_secs}
%{ endif ~}
%{ endif ~}

# Dedicated Moderation (the API key uses the existing VLM secret injection).
COMMUNITY_NODE_MODERATION_API_BASE_URL=${moderation.api_base_url}
COMMUNITY_NODE_MODERATION_MODEL=${moderation.model}
COMMUNITY_NODE_MODERATION_CONFIG_VERSION=${moderation.config_version}
COMMUNITY_NODE_MODERATION_RPM=${moderation.rpm}
COMMUNITY_NODE_MODERATION_RPD=${moderation.rpd}
COMMUNITY_NODE_MODERATION_TPM=${moderation.tpm}
COMMUNITY_NODE_MODERATION_IMAGE_TOKENS=${moderation.image_tokens}
COMMUNITY_NODE_VIDEO_TMPDIR=/run/kukuri-video
