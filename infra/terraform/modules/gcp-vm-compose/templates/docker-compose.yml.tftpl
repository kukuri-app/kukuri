# Generated by Terraform (infra/terraform/modules/gcp-vm-compose). Do not edit on the VM.
# Secrets (CN_POSTGRES_PASSWORD / COMMUNITY_NODE_JWT_SECRET / COMMUNITY_NODE_DATABASE_URL /
# COMMUNITY_NODE_RENDEZVOUS_REDIS_URL) are provided at boot via the project .env file,
# fetched from Secret Manager by the startup script. Non-secret container env lives in
# community-node.env (passed literally via env_file).
x-cn-logging: &cn-logging
  driver: json-file
  options:
    max-size: "20m"
    max-file: "5"

services:
%{ if deploy_local_postgres ~}
  cn-postgres:
    logging: *cn-logging
    image: ${postgres_image}
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${postgres_user}
      POSTGRES_DB: ${postgres_db}
      POSTGRES_PASSWORD: $${CN_POSTGRES_PASSWORD:?set CN_POSTGRES_PASSWORD}
%{ if use_postgres_disk ~}
      # 専用 disk を /var/lib/postgresql/data に mount すると ext4 の lost+found が残り
      # initdb が "directory not empty" で失敗する。公式 image 推奨どおり PGDATA を
      # サブディレクトリにして空ディレクトリへ initdb させる。
      PGDATA: /var/lib/postgresql/data/pgdata
%{ endif ~}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${postgres_user} -d ${postgres_db}"]
      interval: 5s
      timeout: 5s
      retries: 20
    volumes:
%{ if use_postgres_disk ~}
      - ${postgres_data_path}:/var/lib/postgresql/data
%{ else ~}
      - cn-postgres-data:/var/lib/postgresql/data
%{ endif ~}
%{ endif ~}
%{ if deploy_local_valkey ~}
  cn-valkey:
    logging: *cn-logging
    image: ${valkey_image}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "valkey-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 20
%{ endif ~}
  cn-migrate:
    logging: *cn-logging
    image: ${cn_cli_image}
    restart: "no"
    environment:
      COMMUNITY_NODE_DATABASE_URL: $${COMMUNITY_NODE_DATABASE_URL:?set COMMUNITY_NODE_DATABASE_URL}
%{ if deploy_local_postgres ~}
    depends_on:
      cn-postgres:
        condition: service_healthy
%{ endif ~}
    command: ["prepare"]

  cn-user-api:
    logging: *cn-logging
    image: ${cn_user_api_image}
    restart: unless-stopped
    env_file:
      - ./community-node.env
    environment:
      COMMUNITY_NODE_DATABASE_URL: $${COMMUNITY_NODE_DATABASE_URL:?set COMMUNITY_NODE_DATABASE_URL}
      COMMUNITY_NODE_RENDEZVOUS_REDIS_URL: $${COMMUNITY_NODE_RENDEZVOUS_REDIS_URL:?set COMMUNITY_NODE_RENDEZVOUS_REDIS_URL}
      COMMUNITY_NODE_JWT_SECRET: $${COMMUNITY_NODE_JWT_SECRET:?set COMMUNITY_NODE_JWT_SECRET}
      # admin listener is not routed by Caddy. The host port is reachable only from the
      # Google IAP TCP forwarding range through the dedicated firewall rule.
      COMMUNITY_NODE_ADMIN_BIND_ADDR: 0.0.0.0:${admin_port}
      COMMUNITY_NODE_GCP_PROJECT: ${project_id}
%{ if admin_actor != "" ~}
      # Deployment-controlled actor. IAP TCP forwarding does not inject an HTTP principal.
      COMMUNITY_NODE_ADMIN_ACTOR: ${jsonencode(admin_actor)}
%{ endif ~}
%{ if cors_allowed_origins != "" ~}
      COMMUNITY_NODE_CORS_ALLOWED_ORIGINS: ${jsonencode(cors_allowed_origins)}
%{ endif ~}
%{ if legal_data_key_secret_id != "" ~}
      COMMUNITY_NODE_LEGAL_DATA_KEY: $${COMMUNITY_NODE_LEGAL_DATA_KEY:?set COMMUNITY_NODE_LEGAL_DATA_KEY}
%{ endif ~}
%{ if deploy_indexer_stack ~}
      COMMUNITY_NODE_CHANNEL_SECRET_KEY: $${COMMUNITY_NODE_CHANNEL_SECRET_KEY:-}
      COMMUNITY_NODE_ARCADEDB_PASSWORD: $${CN_ARCADEDB_ROOT_PASSWORD:-}
%{ endif ~}
%{ if operator_config_enabled ~}
      # operator-config.yaml を読み込み public manifest endpoint / report_endpoint gating を有効化する。
      COMMUNITY_NODE_OPERATOR_CONFIG: ${operator_config_path}
%{ endif ~}
%{ if operator_config_enabled ~}
    volumes:
      - ./operator-config.yaml:${operator_config_path}:ro
%{ endif ~}
    depends_on:
      cn-migrate:
        condition: service_completed_successfully
%{ if deploy_local_valkey ~}
      cn-valkey:
        condition: service_healthy
%{ endif ~}
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:${api_port}/healthz"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s
    expose:
      - "${api_port}"
    ports:
      - "${admin_port}:${admin_port}"

  cn-iroh-relay:
    logging: *cn-logging
    image: ${cn_iroh_relay_image}
    restart: unless-stopped
    env_file:
      - ./community-node.env
    volumes:
      - ${certs_dir}:${certs_mount}:ro
    expose:
      - "${relay_http_port}"
    ports:
      - "${relay_quic_port}:${relay_quic_internal_port}/udp"

  # STUN（binding だけ。#1483、ADR 0057 §6）。relay の image に同梱した cn-stun を、relay とは別の
  # process として動かす。クライアントは relay の host の 3478/udp へ送る。
  cn-stun:
    logging: *cn-logging
    image: ${cn_iroh_relay_image}
    entrypoint: ["/usr/local/bin/cn-stun"]
    restart: unless-stopped
    ports:
      - "3478:3478/udp"
%{ if deploy_indexer_stack ~}

  # index 投影 + relation graph（#615）。rebuildable projection（canonical store ではない）。
  # container private network 内のみで listen し、host / internet へ port を公開しない。
  cn-arcadedb:
    logging: *cn-logging
    image: ${arcadedb_image}
    restart: unless-stopped
    environment:
      JAVA_OPTS: >-
        -Darcadedb.server.rootPassword=$${CN_ARCADEDB_ROOT_PASSWORD:?set CN_ARCADEDB_ROOT_PASSWORD}
        -Darcadedb.server.defaultDatabases=kukuri_index[]
    healthcheck:
      # image は Alpine ベースで curl が無いため busybox wget を使う。
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:2480/api/v1/ready || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 30s
    expose:
      - "2480"
    volumes:
      - cn-arcadedb-data:/home/arcadedb/databases

  # 常駐 indexing ワーカー（#613 / #615）。provider 未構成なら ingest 無効の fail-closed 常駐。
  # port は expose のみ（host 公開しない）。iroh 通信は outbound で成立する。
  cn-indexer:
    logging: *cn-logging
    image: ${cn_indexer_image}
    restart: unless-stopped
    env_file:
      - ./community-node.env
    tmpfs:
      - /run/kukuri-video:rw,noexec,nosuid,size=64m,mode=0700
    environment:
      COMMUNITY_NODE_DATABASE_URL: $${COMMUNITY_NODE_DATABASE_URL:?set COMMUNITY_NODE_DATABASE_URL}
      COMMUNITY_NODE_CHANNEL_SECRET_KEY: $${COMMUNITY_NODE_CHANNEL_SECRET_KEY:?set COMMUNITY_NODE_CHANNEL_SECRET_KEY}
      COMMUNITY_NODE_ARCADEDB_PASSWORD: $${CN_ARCADEDB_ROOT_PASSWORD:?set CN_ARCADEDB_ROOT_PASSWORD}
      COMMUNITY_NODE_SAFETY_SIGNING_KEY: $${COMMUNITY_NODE_SAFETY_SIGNING_KEY:-}
      PROJECT_ARACHNID_API_USERNAME: $${PROJECT_ARACHNID_API_USERNAME:-}
      PROJECT_ARACHNID_API_PASSWORD: $${PROJECT_ARACHNID_API_PASSWORD:-}
      COMMUNITY_NODE_VLM_API_KEY: $${COMMUNITY_NODE_VLM_API_KEY:-}
      COMMUNITY_NODE_MODERATION_API_BASE_URL: $${COMMUNITY_NODE_MODERATION_API_BASE_URL:-https://api.openai.com/v1}
      COMMUNITY_NODE_MODERATION_MODEL: $${COMMUNITY_NODE_MODERATION_MODEL:-omni-moderation-latest}
      COMMUNITY_NODE_MODERATION_CONFIG_VERSION: $${COMMUNITY_NODE_MODERATION_CONFIG_VERSION:-1}
      COMMUNITY_NODE_MODERATION_RPM: $${COMMUNITY_NODE_MODERATION_RPM:-400}
      COMMUNITY_NODE_MODERATION_RPD: $${COMMUNITY_NODE_MODERATION_RPD:-8000}
      COMMUNITY_NODE_MODERATION_TPM: $${COMMUNITY_NODE_MODERATION_TPM:-8000}
      COMMUNITY_NODE_MODERATION_IMAGE_TOKENS: $${COMMUNITY_NODE_MODERATION_IMAGE_TOKENS:-2048}
      COMMUNITY_NODE_VIDEO_TMPDIR: /run/kukuri-video
    depends_on:
      cn-migrate:
        condition: service_completed_successfully
      cn-arcadedb:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:${indexer_status_port}/healthz"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    expose:
      - "${indexer_status_port}"
    volumes:
%{ if use_indexer_disk ~}
      - ${indexer_data_path}:${indexer_data_path}
%{ else ~}
      - cn-indexer-data:${indexer_data_path}
%{ endif ~}

  # relation graph の定期 batch 解析（#415 / #615）。systemd timer が
  # `docker-compose run --rm cn-relation-analyze` として起動する one-shot。
  # profiles により `up -d` では起動しない。
  cn-relation-analyze:
    logging: *cn-logging
    image: ${cn_cli_image}
    profiles: ["ops"]
    env_file:
      - ./community-node.env
    environment:
      COMMUNITY_NODE_DATABASE_URL: $${COMMUNITY_NODE_DATABASE_URL:?set COMMUNITY_NODE_DATABASE_URL}
      COMMUNITY_NODE_ARCADEDB_PASSWORD: $${CN_ARCADEDB_ROOT_PASSWORD:?set CN_ARCADEDB_ROOT_PASSWORD}
    command: ["relation", "analyze"]
    restart: "no"
%{ if operator_config_enabled ~}

  # readiness activation は短命（既定15分）のため、systemd timer が5分ごとに
  # production credential probeを含む全判定を再実行する。失敗時はCLIが旧activationを
  # revokeし、user-apiのread-time gateが直ちにsurfaceを閉じる。
  cn-readiness:
    logging: *cn-logging
    image: ${cn_cli_image}
    profiles: ["ops"]
    env_file:
      - ./community-node.env
    tmpfs:
      - /run/kukuri-video:rw,noexec,nosuid,size=64m,mode=0700
    environment:
      COMMUNITY_NODE_DATABASE_URL: $${COMMUNITY_NODE_DATABASE_URL:?set COMMUNITY_NODE_DATABASE_URL}
      COMMUNITY_NODE_ARCADEDB_PASSWORD: $${CN_ARCADEDB_ROOT_PASSWORD:?set CN_ARCADEDB_ROOT_PASSWORD}
      PROJECT_ARACHNID_API_USERNAME: $${PROJECT_ARACHNID_API_USERNAME:-}
      PROJECT_ARACHNID_API_PASSWORD: $${PROJECT_ARACHNID_API_PASSWORD:-}
      COMMUNITY_NODE_VLM_API_KEY: $${COMMUNITY_NODE_VLM_API_KEY:-}
      COMMUNITY_NODE_MODERATION_API_BASE_URL: $${COMMUNITY_NODE_MODERATION_API_BASE_URL:-https://api.openai.com/v1}
      COMMUNITY_NODE_MODERATION_MODEL: $${COMMUNITY_NODE_MODERATION_MODEL:-omni-moderation-latest}
      COMMUNITY_NODE_MODERATION_CONFIG_VERSION: $${COMMUNITY_NODE_MODERATION_CONFIG_VERSION:-1}
      COMMUNITY_NODE_MODERATION_RPM: $${COMMUNITY_NODE_MODERATION_RPM:-400}
      COMMUNITY_NODE_MODERATION_RPD: $${COMMUNITY_NODE_MODERATION_RPD:-8000}
      COMMUNITY_NODE_MODERATION_TPM: $${COMMUNITY_NODE_MODERATION_TPM:-8000}
      COMMUNITY_NODE_MODERATION_IMAGE_TOKENS: $${COMMUNITY_NODE_MODERATION_IMAGE_TOKENS:-2048}
      COMMUNITY_NODE_VIDEO_TMPDIR: /run/kukuri-video
    volumes:
      - ./operator-config.yaml:${operator_config_path}:ro
    command: ["readiness", "--config", "${operator_config_path}"]
    restart: "no"
%{ endif ~}
%{ endif ~}

  caddy:
    logging: *cn-logging
    image: ${caddy_image}
    restart: unless-stopped
    depends_on:
      - cn-user-api
      - cn-iroh-relay
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - ${certs_dir}:${certs_mount}:ro
      - ./acme-webroot:/var/www/acme:ro
      - caddy-data:/data
      - caddy-config:/config
    ports:
      - "80:80"
      - "443:443"

volumes:
%{ if deploy_local_postgres && !use_postgres_disk ~}
  cn-postgres-data:
%{ endif ~}
%{ if deploy_indexer_stack ~}
  # ArcadeDB data は rebuildable projection（真実源は Postgres）のため named volume。
  # VM 置換で失われた場合は runbook の再構築手順（空 DB から indexer 再投影）で復元する。
  cn-arcadedb-data:
%{ if !use_indexer_disk ~}
  cn-indexer-data:
%{ endif ~}
%{ endif ~}
  caddy-data:
  caddy-config:
