# Copy to terraform.tfvars and fill in. Never put secret VALUES here; only
# Secret Manager secret IDs. terraform.tfvars is gitignored.

project_id = "your-gcp-project"
region     = "asia-northeast1"
zone       = "asia-northeast1-a"

api_domain   = "api.example.com"
relay_domain = "iroh-relay.example.com"
acme_email   = "ops@example.com"
# 空なら admin UI は read-only。write を有効にする場合だけ operator 自身の actor を明示する。
admin_actor  = "ops@example.com"
# Web クライアントの配信元（ADR 0060 §2）。空なら CORS で応答しない。
cors_allowed_origins = ["https://app.example.com"]
safety_operator_review = true

# Cloud DNS で A レコードを自動作成する場合は true + zone 名。
# false の場合は terraform output static_ip を手動 DNS に設定する。
manage_cloud_dns = false
dns_zone_name    = ""

# public GHCR images（tag または digest 込み）
cn_user_api_image   = "ghcr.io/kukuri-app/kukuri-cn-user-api:latest"
cn_iroh_relay_image = "ghcr.io/kukuri-app/kukuri-cn-iroh-relay:latest"
cn_cli_image        = "ghcr.io/kukuri-app/kukuri-cn-cli:latest"

# Secret Manager secret IDs（payload は事前に gcloud で作成しておく）
jwt_secret_id               = "kukuri-cn-jwt-secret"
postgres_password_secret_id = "kukuri-cn-postgres-password"
legal_data_key_secret_id    = "kukuri-cn-legal-data-key"

# sizing（任意。既定は e2-small / 30GB）
machine_type = "e2-small"
disk_size_gb = 30

# backup（任意）
backup_enabled        = true
backup_retention_days = 30

# Cloud Monitoring alert policies are enabled by default. Add one or more
# pre-created notification channel resource names before production apply.
enable_community_node_monitoring = true
# Only for a node that promises indexing of these topics. Register them through
# the audited admin UI first; this monitors them and never changes the database.
# index_expected_topics = ["kukuri:topic:general", "kukuri:topic:test", "kukuri:topic:dev"]
# monitoring_notification_channels = [
#   "projects/your-gcp-project/notificationChannels/1234567890",
# ]

# operator-config.yaml を VM へ配置して public manifest endpoint /
# report_endpoint gating を有効化する（#380, 任意）。
# この env ディレクトリに operator-config.yaml を置き、相対パスを指定する。
# main.tf が file() で読み込んで VM に配置する。空（既定）なら manifest endpoint は 404 のまま。
# operator_config_path = "operator-config.yaml"
